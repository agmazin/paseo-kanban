import { readFile } from "node:fs/promises";
import { createRequire } from "node:module";
import { slim, topLevel } from "/Users/agmazin/Yandex.Disk.localized/public/projects/local/paseo-dialogs/shared/model.ts";
import { cardsOf } from "/Users/agmazin/Yandex.Disk.localized/public/projects/local/paseo-kanban/shared/model.ts";
const require = createRequire("/Users/agmazin/Library/Developer/paseo-kanban/package.json");
const { DaemonClient } = await import(require.resolve("@getpaseo/client/internal/daemon-client"));
const home = "/Users/agmazin/.paseo";
const pid = JSON.parse(await readFile(home + "/paseo.pid", "utf8"));
const c = new DaemonClient({ url: `ws://${pid.listen}/ws`, clientId: "kanban-perf-probe", clientType: "cli", localCredential: async () => (await readFile(home + "/local-credential", "utf8")).trim(), reconnect: { enabled: false } });
await c.connect();
let cursor: string | undefined; const all: any[] = [];
do { const r = await c.fetchAgents({ filter: { includeArchived: true }, page: { limit: 200, cursor } }); all.push(...r.entries.map((e: any) => e.agent)); cursor = r.pageInfo.nextCursor ?? undefined; } while (cursor);
const kb = (x: unknown) => Math.round(JSON.stringify(x).length / 1024);
console.log("полные снимки:", all.length, "агентов,", kb(all), "КБ");
console.log("Диалоги, короткие строки:", kb(all.filter(topLevel).map(slim)), "КБ");
console.log("Канбан, карточки с архивом:", kb(cardsOf(all)), "КБ; живые:", kb(cardsOf(all.filter((a) => !a.archivedAt))), "КБ");
const top = all.filter(topLevel);
console.log("Диалоги при старте (живые + счётчики архива):", kb(top.filter((a) => !a.archivedAt).map(slim)), "КБ, живых", top.filter((a) => !a.archivedAt).length);
await c.close();
